From 0a0db0eb488c3e76b18f86e8ef7efae038a1ef25 Mon Sep 17 00:00:00 2001
From: Prasoon Mishra <Prasoon.Mishra@amd.com>
Date: Wed, 7 Jan 2026 10:40:56 +0000
Subject: [PATCH 1/2] [AMDGPU] Decouple FinalizeISel iteration from
 EmitInstrWithCustomInserter return value

FinalizeISel was using EmitInstrWithCustomInserter's return value to
determine where to continue iteration. But the API only guarantees
"return a different block if CFG changed", not which specific block.

Fix by detecting block splits directly: if MBBI's instruction moved to
a different parent block, exit the inner loop. The split-off block will
be processed when the outer loop reaches it. This decouples iteration
logic from the return value's specific semantics.

Fixes a bug where AMDGPU's insertSimulatedTrap returned HaltLoopBB,
causing FinalizeISel to skip intermediate blocks and leave pseudos
unexpanded leading to a crash.

Fix: SWDEV-572407
---
 llvm/lib/CodeGen/FinalizeISel.cpp             |  8 +--
 .../AMDGPU/simulated-trap-pseudo-expand.ll    | 56 +++++++++++++++++++
 2 files changed, 60 insertions(+), 4 deletions(-)
 create mode 100644 llvm/test/CodeGen/AMDGPU/simulated-trap-pseudo-expand.ll

diff --git a/llvm/lib/CodeGen/FinalizeISel.cpp b/llvm/lib/CodeGen/FinalizeISel.cpp
index 7069a8862b7df..5c470085c6de6 100644
--- a/llvm/lib/CodeGen/FinalizeISel.cpp
+++ b/llvm/lib/CodeGen/FinalizeISel.cpp
@@ -68,10 +68,10 @@ static std::pair<bool, bool> runImpl(MachineFunction &MF) {
         // The expansion may involve new basic blocks.
         if (NewMBB != MBB) {
           PreserveCFG = false;
-          MBB = NewMBB;
-          I = NewMBB->getIterator();
-          MBBI = NewMBB->begin();
-          MBBE = NewMBB->end();
+          // Check if the block was split.
+          if (MBBI != MBBE && MBBI->getParent() != MBB)
+            break;
+          // No split: MBBI still valid in MBB, continue processing.
         }
       }
     }
diff --git a/llvm/test/CodeGen/AMDGPU/simulated-trap-pseudo-expand.ll b/llvm/test/CodeGen/AMDGPU/simulated-trap-pseudo-expand.ll
new file mode 100644
index 0000000000000..9796db4717e7b
--- /dev/null
+++ b/llvm/test/CodeGen/AMDGPU/simulated-trap-pseudo-expand.ll
@@ -0,0 +1,56 @@
